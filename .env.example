# Copy to .env and fill in. Both keys stay on your machine.
ASSEMBLYAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional
# CLAUDE_MODEL=claude-sonnet-4-6      # model for the name-guessing pass
# SUMMARY_MODEL=claude-opus-5         # model for interview summaries
# SUMMARY_MAX_WORDS=700               # length budget for a summary (~2 pages)
# AAI_SPEECH_MODEL=                   # leave blank for AssemblyAI's default
# AAI_LANGUAGE=en                     # leave blank for auto-detect
# WORKERS=3                           # files transcribed in parallel
# DATA_DIR=data                       # where audio + transcripts live

# Publishing approved transcripts to a read-only site (see README)
# PUBLISH_REPO=git@github.com:you/matlack-site.git   # empty private repo, Pages on
# PUBLISH_PASSPHRASE=                 # the site asks for this; pick something long
# PUBLISH_URL=https://you.github.io/matlack-site      # for the "View site" link
# PUBLISH_BRANCH=main                 # branch Pages serves
# PUBLISH_PUBLIC=1                    # only if you really want it unencrypted
