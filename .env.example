# Copy to .env and fill in. Both keys stay on your machine.
ASSEMBLYAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional
# CLAUDE_MODEL=claude-opus-5         # model for naming, review and summaries
# SUMMARY_MODEL=                      # a different model for summaries only, if wanted
# SUMMARY_MAX_WORDS=700               # length budget for a summary (~2 pages)
# CLEANUP_MODEL=claude-fable-5-1      # model for the text-tidying pass
# CLEANUP_EFFORT=medium               # low | medium | high — how hard it thinks about it
# CLEANUP=0                           # off: leave the transcript exactly as recorded
# AAI_SPEECH_MODEL=                   # leave blank for AssemblyAI's default
# AAI_LANGUAGE=en                     # leave blank for auto-detect
# AAI_ADVANCED_DIARIZATION=1          # AssemblyAI's experimental diarization: better with many
#                                     # speakers or rough audio, a few cents more per hour
# AAI_ENTITY_DETECTION=0              # off: skip the names/roles AssemblyAI picks out for the
#                                     # naming pass (it bills a little extra per hour)
# AAI_CONTEXT=0                       # off: stop telling AssemblyAI the meeting title, the
#                                     # people and the interview guide before it transcribes
# AAI_CONTEXT_GUIDE=                  # a guide other than the default one for that context
# SPELLINGS_FILE=spellings.txt        # names the transcriber should always spell one way
# WORKERS=3                           # files transcribed in parallel
# DATA_DIR=data                       # where audio + transcripts live

# Publishing approved transcripts to a read-only site (see README)
# PUBLISH_REPO=https://github.com/you/matlack   # this repo, or a separate one
# PUBLISH_BRANCH=gh-pages             # branch the site lives on (main for a separate repo)
# PUBLISH_PASSPHRASE=                 # the site asks for this; pick something long
# PUBLISH_URL=https://you.github.io/matlack      # for the "View site" link
# PUBLISH_PUBLIC=1                    # only if you really want it unencrypted
